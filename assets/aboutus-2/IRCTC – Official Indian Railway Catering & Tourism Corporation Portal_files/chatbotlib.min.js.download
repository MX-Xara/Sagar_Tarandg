const DISABLE_ASKDISHA_IRCTC = false;
const ONLY_SHOW_WIDGET_NO_ADS = true;

// List of paths where you do NOT want to o load the script
const includedPaths = [
  "/nget/train-search",
  "/eticket/train-search"
];

// Get the current page path
const currentPath = window.location.pathname;

// Check if the current path is in the included list
if (includedPaths.includes(currentPath)) {
  // Google Analytics integration
  function gtag() {
    dataLayer.push(arguments);
  }

  let scriptGA = document.createElement("script");
  scriptGA.type = "text/javascript";
  scriptGA.src = "https://www.googletagmanager.com/gtag/js?id=UA-122267849-1";
  document.getElementsByTagName("head")[0].appendChild(scriptGA);

  (window.dataLayer = window.dataLayer || []),
    gtag("js", new Date()),
    gtag("config", "UA-122267849-1");

  if (!DISABLE_ASKDISHA_IRCTC) {
    if (!ONLY_SHOW_WIDGET_NO_ADS) {
      // VDO.AI CORE SCRIPT ADDED HERE (Step 1)
      var vdoAiCore = document.createElement("script");
      vdoAiCore.async = true; // Use async and defer as per VDO.AI instructions
      vdoAiCore.defer = true;
      vdoAiCore.src = "https://a.vdo.ai/core/b-irctc-co-in/vdo.ai.js";
      document.head.appendChild(vdoAiCore);
    }

    // Chatbot integration CDN UPDATE
    // var dishaSdk = document.createElement("script");
    // dishaSdk.src =
    //   "https://sdk.irctc.corover.ai/sdk/irctc_disha.widget.js?" +
    //   new Date().getTime();

    if (!ONLY_SHOW_WIDGET_NO_ADS) {
      var dishaAds = document.createElement("script");
      dishaAds.src =
        "https://sdk.irctc.corover.ai/ads/irctc_disha.ads.js?" +
        new Date().getTime();
      document.head.appendChild(dishaAds);
    }

    document.head.appendChild(dishaSdk);
  }
